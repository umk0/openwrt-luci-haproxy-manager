#!/bin/sh
set -eu
. /usr/libexec/haproxy-manager/common.sh

OUT="${1:-$TMP_CFG}"
ENABLED="$(uci_get main enabled 0)"
ENABLE_HTTP="$(uci_get main enable_http 1)"
ENABLE_HTTPS="$(uci_get main enable_https_passthrough 0)"
HTTP_PORT="$(uci_get main http_port 80)"
HTTPS_PORT="$(uci_get main https_port 443)"
WAN_IP="$(wan_ip || true)"

if [ "$ENABLED" != 1 ]; then
	echo "Generated HAProxy config is disabled. Enable it on the Domain Routes page before validating or applying." >&2
	exit 2
fi

[ "$ENABLE_HTTP" != 1 ] || is_valid_port "$HTTP_PORT" || { echo "Invalid HTTP port: $HTTP_PORT" >&2; exit 1; }
[ "$ENABLE_HTTPS" != 1 ] || is_valid_port "$HTTPS_PORT" || { echo "Invalid HTTPS port: $HTTPS_PORT" >&2; exit 1; }

if [ -z "$WAN_IP" ]; then
	echo "Cannot detect WAN IPv4 address. Set wan_bind_ip manually." >&2
	exit 1
fi

TMP_HTTP_RULES=/tmp/haproxy-manager-http-rules.$$
TMP_HTTP_BACKENDS=/tmp/haproxy-manager-http-backends.$$
TMP_TLS_RULES=/tmp/haproxy-manager-tls-rules.$$
TMP_TLS_BACKENDS=/tmp/haproxy-manager-tls-backends.$$
TMP_TCP_FRONTENDS=/tmp/haproxy-manager-tcp-frontends.$$
TMP_PORTS=/tmp/haproxy-manager-listen-ports.$$
: > "$TMP_HTTP_RULES"
: > "$TMP_HTTP_BACKENDS"
: > "$TMP_TLS_RULES"
: > "$TMP_TLS_BACKENDS"
: > "$TMP_TCP_FRONTENDS"
: > "$TMP_PORTS"
trap 'rm -f "$TMP_HTTP_RULES" "$TMP_HTTP_BACKENDS" "$TMP_TLS_RULES" "$TMP_TLS_BACKENDS" "$TMP_TCP_FRONTENDS" "$TMP_PORTS"' EXIT

if [ "$ENABLE_HTTP" = 1 ]; then
	printf '%s\tHTTP listener\n' "$HTTP_PORT" >> "$TMP_PORTS"
fi

if [ "$ENABLE_HTTPS" = 1 ]; then
	if grep -q "^${HTTPS_PORT}[[:space:]]" "$TMP_PORTS"; then
		echo "HTTPS port conflicts with the HTTP listener: $HTTPS_PORT" >&2
		exit 1
	fi
	printf '%s\tHTTPS listener\n' "$HTTPS_PORT" >> "$TMP_PORTS"
fi

HAS_TCP=0

for section in $(uci -q show "$CONFIG" | sed -n "s/^$CONFIG\\.\\(@route\\[[0-9][0-9]*\\]\\)=route/\\1/p"); do
	enabled="$(uci_get "$section" enabled 1)"
	[ "$enabled" = 1 ] || continue

	host="$(uci_get "$section" host)"
	protocol="$(uci_get "$section" protocol http)"
	backend_host="$(uci_get "$section" backend_host)"
	backend_port="$(uci_get "$section" backend_port)"
	listen_port="$(uci_get "$section" listen_port "$backend_port")"

	is_valid_ip_or_host "$backend_host" || { echo "Invalid backend host: $backend_host" >&2; exit 1; }
	is_valid_port "$backend_port" || { echo "Invalid backend port for $host: $backend_port" >&2; exit 1; }

	case "$protocol" in
		http|https|both)
			is_valid_host "$host" || { echo "Invalid or missing host for $protocol route: $host" >&2; exit 1; }
		;;
		tcp)
			is_valid_port "$listen_port" || { echo "Invalid TCP listen port: $listen_port" >&2; exit 1; }
		;;
		*)
			echo "Invalid route protocol: $protocol" >&2
			exit 1
		;;
	esac

	label="$(uci_get "$section" name)"
	[ -n "$label" ] || label="$host"
	[ -n "$label" ] || label="tcp_$listen_port"
	name="$(route_name "${label}_${backend_host}_${backend_port}_${listen_port}")"

	case "$protocol" in
		http|both)
			{
				printf '  acl host_%s hdr(host) -i %s\n' "$name" "$host"
				printf '  use_backend be_%s if host_%s\n' "$name" "$name"
			} >> "$TMP_HTTP_RULES"
			{
				printf 'backend be_%s\n' "$name"
				printf '  mode http\n'
				printf '  option httpchk GET /\n'
				printf '  server srv1 %s:%s check\n\n' "$backend_host" "$backend_port"
			} >> "$TMP_HTTP_BACKENDS"
		;;
	esac

	case "$protocol" in
		https|both)
			{
				printf '  use_backend be_tls_%s if { req.ssl_sni -i %s }\n' "$name" "$host"
			} >> "$TMP_TLS_RULES"
			{
				printf 'backend be_tls_%s\n' "$name"
				printf '  mode tcp\n'
				printf '  server srv1 %s:%s check\n\n' "$backend_host" "$backend_port"
			} >> "$TMP_TLS_BACKENDS"
		;;
	esac

	case "$protocol" in
		tcp)
			if grep -q "^${listen_port}[[:space:]]" "$TMP_PORTS"; then
				owner="$(sed -n "s/^${listen_port}[[:space:]]*//p" "$TMP_PORTS" | head -1)"
				echo "TCP listen port $listen_port conflicts with ${owner:-another route}." >&2
				exit 1
			fi
			printf '%s\tTCP route %s\n' "$listen_port" "${label:-$listen_port}" >> "$TMP_PORTS"
			HAS_TCP=1
			{
				printf 'frontend fe_tcp_%s\n' "$name"
				printf '  bind %s:%s\n' "$WAN_IP" "$listen_port"
				printf '  mode tcp\n'
				printf '  default_backend be_tcp_%s\n\n' "$name"
				printf 'backend be_tcp_%s\n' "$name"
				printf '  mode tcp\n'
				printf '  server srv1 %s:%s check\n\n' "$backend_host" "$backend_port"
			} >> "$TMP_TCP_FRONTENDS"
		;;
	esac
done

if [ "$ENABLE_HTTP" != 1 ] && [ "$ENABLE_HTTPS" != 1 ] && [ "$HAS_TCP" != 1 ]; then
	echo "No HAProxy listeners are enabled. Enable HTTP, HTTPS SNI, or add an enabled TCP port-forward route." >&2
	exit 2
fi

{
	printf '# Generated by luci-app-haproxy-manager. Manual changes may be overwritten.\n'
	printf 'global\n'
	printf '  log /dev/log local0\n'
	printf '  maxconn 2048\n'
	printf '  daemon\n\n'
	printf 'defaults\n'
	printf '  log global\n'
	printf '  timeout connect 5s\n'
	printf '  timeout client 60s\n'
	printf '  timeout server 60s\n'
	printf '  option dontlognull\n\n'

	if [ "$ENABLE_HTTP" = 1 ]; then
		printf 'frontend fe_http\n'
		printf '  bind %s:%s\n' "$WAN_IP" "$HTTP_PORT"
		printf '  mode http\n'
		printf '  option httplog\n'
		cat "$TMP_HTTP_RULES"
		printf '  default_backend be_not_found\n\n'
		cat "$TMP_HTTP_BACKENDS"
	fi

	if [ "$ENABLE_HTTPS" = 1 ]; then
		printf 'frontend fe_https_passthrough\n'
		printf '  bind %s:%s\n' "$WAN_IP" "$HTTPS_PORT"
		printf '  mode tcp\n'
		printf '  tcp-request inspect-delay 5s\n'
		printf '  tcp-request content accept if { req.ssl_hello_type 1 }\n'
		cat "$TMP_TLS_RULES"
		printf '  default_backend be_tls_not_found\n\n'
		cat "$TMP_TLS_BACKENDS"
	fi

	cat "$TMP_TCP_FRONTENDS"

	printf 'backend be_not_found\n'
	printf '  mode http\n'
	printf '  http-request return status 404 content-type text/plain string "No HAProxy route matched this host.\\n"\n\n'
	printf 'backend be_tls_not_found\n'
	printf '  mode tcp\n'
	printf '  tcp-request content reject\n'
} > "$OUT"

printf '%s\n' "$OUT"
